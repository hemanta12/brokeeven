generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SplitMethod {
  equal
  percent
  custom
}

enum ActivityAction {
  expense_add
  expense_edit
  expense_delete
  person_add
  person_remove
  person_rename
  settlement
}

model Group {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  label        String?
  joinCode     String        @unique
  createdAt    DateTime      @default(now())
  people       Person[]
  expenses     Expense[]
  settlements  Settlement[]
  activityLogs ActivityLog[]
}

model Person {
  id              String         @id @default(uuid()) @db.Uuid
  groupId         String         @db.Uuid
  name            String
  email           String?
  removedAt       DateTime?
  createdAt       DateTime       @default(now())
  group           Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidExpenses    Expense[]      @relation("ExpensePayer")
  expenseSplits   ExpenseSplit[]
  settlementsFrom Settlement[]   @relation("SettlementFrom")
  settlementsTo   Settlement[]   @relation("SettlementTo")

  @@index([groupId])
}

model Expense {
  id             String         @id @default(uuid()) @db.Uuid
  groupId        String         @db.Uuid
  title          String
  description    String?
  amount         Decimal        @db.Decimal(12, 2)
  date           DateTime       @db.Date
  payerId        String         @db.Uuid
  splitMethod    SplitMethod
  idempotencyKey String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  group          Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer          Person         @relation("ExpensePayer", fields: [payerId], references: [id], onDelete: Restrict)
  splits         ExpenseSplit[]

  @@index([groupId])
  @@index([payerId])
}

model ExpenseSplit {
  id             String   @id @default(uuid()) @db.Uuid
  expenseId      String   @db.Uuid
  personId       String   @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  percentAtEntry Decimal? @db.Decimal(5, 2)
  expense        Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  person         Person   @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@unique([expenseId, personId])
  @@index([expenseId])
  @@index([personId])
}

model Settlement {
  id           String   @id @default(uuid()) @db.Uuid
  groupId      String   @db.Uuid
  fromPersonId String   @db.Uuid
  toPersonId   String   @db.Uuid
  amount       Decimal  @db.Decimal(12, 2)
  note         String
  settledAt    DateTime @default(now())
  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromPerson   Person   @relation("SettlementFrom", fields: [fromPersonId], references: [id], onDelete: Restrict)
  toPerson     Person   @relation("SettlementTo", fields: [toPersonId], references: [id], onDelete: Restrict)

  @@index([groupId])
  @@index([fromPersonId])
  @@index([toPersonId])
}

model ActivityLog {
  id        String         @id @default(uuid()) @db.Uuid
  groupId   String         @db.Uuid
  action    ActivityAction
  actorName String?
  detail    String?
  createdAt DateTime       @default(now())
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}
