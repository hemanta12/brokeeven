generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SplitMethod {
  equal
  percent
  custom
}

// Group-level, never per-device: two members on different modes reach the same
// debt through two framings and double-record the payment.
enum SettleMode {
  direct
  simplified
}

enum ActivityAction {
  expense_add
  expense_edit
  expense_delete
  person_add
  person_remove
  person_rename
  settlement
  settlement_delete
  group_edit
  group_close
  group_reopen
}

// One row per actor. A guest is a User with googleSub = null; sign-in promotes
// that same row in place, so anonymous entries keep their owner id.
model User {
  id         String   @id @default(uuid()) @db.Uuid
  googleSub  String?  @unique
  email      String?
  name       String?
  avatarUrl  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  people     Person[]
}

model Group {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  label        String?
  joinCode     String        @unique
  // ISO 4217, validated against an allowlist at the API (see split/money.ts).
  currency     String        @default("USD")
  // Set once the group is closed out. Reversible via POST /groups/:code/reopen.
  closedAt     DateTime?
  // Balances at or below this (in currency units) are written off at close-out.
  forgiveThreshold Decimal   @default(0) @db.Decimal(12, 2)
  settleMode   SettleMode    @default(direct)
  // Gates delete only; edit stays open to anyone with the code. NULL means
  // unowned (legacy groups), so anyone may delete.
  createdByUserId String?    @db.Uuid
  createdAt    DateTime      @default(now())
  people       Person[]
  expenses     Expense[]
  settlements  Settlement[]
  activityLogs ActivityLog[]

  @@index([createdByUserId])
}

model Person {
  id              String         @id @default(uuid()) @db.Uuid
  groupId         String         @db.Uuid
  name            String
  // Free text: a Venmo/UPI id, a payment link, or a note like "cash only".
  // Displayed at settle time; the app never parses or transacts on it.
  paymentHandle   String?        @db.VarChar(100)
  userId          String?        @db.Uuid
  removedAt       DateTime?
  createdAt       DateTime       @default(now())
  group           Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  paidExpenses    Expense[]      @relation("ExpensePayer")
  expenseSplits   ExpenseSplit[]
  settlementsFrom Settlement[]   @relation("SettlementFrom")
  settlementsTo   Settlement[]   @relation("SettlementTo")

  // One account claims at most one person per group. Postgres allows multiple
  // NULL userId rows per group.
  @@unique([groupId, userId])
  @@index([groupId])
}

model Expense {
  id             String         @id @default(uuid()) @db.Uuid
  groupId        String         @db.Uuid
  title          String
  description    String?
  amount         Decimal        @db.Decimal(12, 2)
  date           DateTime       @db.Date
  payerId        String         @db.Uuid
  splitMethod    SplitMethod
  idempotencyKey String?        @unique
  // null => unowned (predates ownership, or a cookie-less client): anyone in the
  // group may edit it.
  createdByUserId String?       @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  group          Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer          Person         @relation("ExpensePayer", fields: [payerId], references: [id], onDelete: Restrict)
  splits         ExpenseSplit[]

  @@index([groupId])
  @@index([payerId])
  @@index([createdByUserId])
}

model ExpenseSplit {
  id             String   @id @default(uuid()) @db.Uuid
  expenseId      String   @db.Uuid
  personId       String   @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  percentAtEntry Decimal? @db.Decimal(5, 2)
  expense        Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  person         Person   @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@unique([expenseId, personId])
  @@index([expenseId])
  @@index([personId])
}

model Settlement {
  id           String   @id @default(uuid()) @db.Uuid
  groupId      String   @db.Uuid
  fromPersonId String   @db.Uuid
  toPersonId   String   @db.Uuid
  amount       Decimal  @db.Decimal(12, 2)
  note         String
  createdByUserId String? @db.Uuid
  settledAt    DateTime @default(now())
  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromPerson   Person   @relation("SettlementFrom", fields: [fromPersonId], references: [id], onDelete: Restrict)
  toPerson     Person   @relation("SettlementTo", fields: [toPersonId], references: [id], onDelete: Restrict)

  @@index([groupId])
  @@index([fromPersonId])
  @@index([toPersonId])
  @@index([createdByUserId])
}

model ActivityLog {
  id        String         @id @default(uuid()) @db.Uuid
  groupId   String         @db.Uuid
  action    ActivityAction
  actorName String?
  detail    String?
  createdAt DateTime       @default(now())
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}
